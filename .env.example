# Public browser configuration (Cloudflare build environment)
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_OR_PUBLISHABLE_KEY
# Cloudflare Pages Function runtime variables; never prefix the service key with VITE_
